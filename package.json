{
  "name": "@jankrajewskiit/data",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvet-data.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "types": "./styles.d.ts",
      "default": "./dist/velvet-data.css"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "npm@11.13.0",
  "files": [
    "dist/**/*",
    "styles.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepublishOnly": "npm run verify",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "verify": "npm run typecheck && npm run lint && npm run lint:css && npm run build && npm run verify:pkg",
    "verify:pkg": "publint && attw --pack . --entrypoints . --profile esm-only --ignore-rules internal-resolution-error",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@jankrajewskiit/ui": ">=2.0.0",
    "lightweight-charts": ">=5.1.0",
    "solid-icons": ">=1.2.0",
    "solid-js": ">=1.9"
  },
  "peerDependenciesMeta": {
    "lightweight-charts": {
      "optional": true
    },
    "solid-icons": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@jankrajewskiit/configs": "^1.1.1",
    "@jankrajewskiit/ui": "^2.0.6",
    "@types/node": "^25.6.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lightweight-charts": "^5.2.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.18",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.12",
    "stylelint": "^17.9.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^4.5.4"
  }
}
