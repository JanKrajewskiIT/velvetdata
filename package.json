{
  "name": "@jankrajewskiit/data",
  "version": "0.2.8",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvetdata.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "types": "./styles.d.ts",
      "default": "./dist/velvet-data.css"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "npm@12.2.0",
  "files": [
    "dist/**/*",
    "styles.d.ts"
  ],
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "prepublishOnly": "npm run verify",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "verify": "npm run typecheck && npm run lint && npm run lint:css && npm run build && npm run verify:pkg",
    "verify:pkg": "publint && attw --pack . --entrypoints . --profile esm-only --ignore-rules internal-resolution-error",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@jankrajewskiit/ui": ">=3.0.0",
    "lightweight-charts": ">=5.1.0",
    "solid-icons": ">=1.2.0",
    "solid-js": ">=1.9"
  },
  "peerDependenciesMeta": {
    "lightweight-charts": {
      "optional": true
    },
    "solid-icons": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jankrajewskiit/configs": "^3.4.2",
    "@jankrajewskiit/ui": "^3.4.4",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lightweight-charts": "^5.2.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.17",
    "stylelint": "^17.16.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  }
}
