{
  "name": "@jankrajewskiit/data",
  "version": "3.4.8",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvetdata.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tradingview": {
      "types": "./dist/tradingview.d.ts",
      "import": "./dist/tradingview.js"
    },
    "./styles": {
      "types": "./styles.d.ts",
      "default": "./dist/velvet-data.css"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "npm@12.2.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "dist/**/*",
    "styles.d.ts"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepublishOnly": "npm run verify",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "verify": "npm run format:check && npm run lint && npm run lint:css && npm run build && npm run verify:pkg",
    "verify:pkg": "publint --strict && attw --pack . --entrypoints . ./tradingview --profile esm-only --ignore-rules internal-resolution-error",
    "size": "size-limit",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@jankrajewskiit/ui": ">=3.4.7 <4",
    "lightweight-charts": ">=5.1.0 <6",
    "solid-js": ">=1.9.0 <2",
    "@jankrajewskiit/i18n": "^3.4.2"
  },
  "peerDependenciesMeta": {
    "lightweight-charts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jankrajewskiit/configs": "^3.4.2",
    "@jankrajewskiit/i18n": "^3.4.3",
    "@jankrajewskiit/ui": "^3.4.8",
    "@size-limit/file": "^14.2.0",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lightweight-charts": "^5.2.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "solid-js": "^1.9.17",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "100 kB"
    },
    {
      "path": "dist/velvet-data.css",
      "limit": "50 kB"
    }
  ],
  "description": "Advanced SolidJS data components composed from Velvet UI."
}
