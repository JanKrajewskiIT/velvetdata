{
  "name": "@jankrajewskiit/data",
  "version": "3.8.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvetdata.git"
  },
  "exports": {
    "./bare": {
      "types": "./dist/bare.d.mts",
      "import": "./dist/bare.mjs"
    },
    "./styles/*": {
      "types": "./styles.d.ts",
      "default": "./dist/styles/presets/*.css"
    },
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./tradingview": {
      "types": "./dist/tradingview.d.mts",
      "import": "./dist/tradingview.mjs"
    },
    "./styles": {
      "types": "./styles.d.ts",
      "default": "./dist/velvet-data.css"
    }
  },
  "types": "./dist/index.d.mts",
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "npm@12.2.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "dist/**/*",
    "styles.d.ts"
  ],
  "scripts": {
    "prepublishOnly": "npm run verify",
    "build": "tsc -b && vite build && node scripts/packageStyles.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix --max-warnings 0",
    "verify": "npm run toolchain && npm run editor:check && npm run format:check && npm run lint && npm run quality:check && npm run lint:css && npm run build && npm run verify:pkg && npm run size",
    "verify:pkg": "npm run verify:types && publint --strict && attw --pack . --entrypoints . ./bare ./tradingview --profile esm-only",
    "size": "size-limit",
    "prepare": "husky",
    "toolchain": "configs-toolchain",
    "audit:deps": "configs-audit",
    "prebuild": "npm run toolchain",
    "verify:types": "tsc -p tsconfig.declarations.json",
    "editor:sync": "configs-editor --write",
    "editor:check": "configs-editor",
    "deps:check": "knip --no-exit-code --reporter json",
    "deps:strict": "configs-unused",
    "architecture:check": "configs-architecture",
    "duplicates:report": "configs-duplicates",
    "quality:check": "npm run architecture:check && npm run duplicates:report && npm run deps:strict"
  },
  "peerDependencies": {
    "@jankrajewskiit/i18n": ">=3.4.4 <4",
    "@jankrajewskiit/ui": ">=3.8.1 <4",
    "lightweight-charts": ">=5.1.0 <6",
    "solid-js": ">=1.9.0 <2"
  },
  "peerDependenciesMeta": {
    "lightweight-charts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jankrajewskiit/configs": "^3.8.0",
    "@jankrajewskiit/i18n": "^3.8.0",
    "@jankrajewskiit/ui": "^3.8.1",
    "@size-limit/file": "^14.2.0",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lightweight-charts": "^5.2.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "solid-js": "^1.9.17",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vite": "^8.3.4",
    "dependency-cruiser": "^18.6.0",
    "jscpd": "~5.4.1"
  },
  "size-limit": [
    {
      "path": "dist/**/*.mjs",
      "limit": "100 kB",
      "name": "Published JavaScript (all modules)"
    },
    {
      "path": "dist/velvet-data.css",
      "limit": "50 kB"
    }
  ],
  "description": "Advanced SolidJS data components composed from Velvet UI.",
  "overrides": {
    "eslint": "$eslint"
  }
}
